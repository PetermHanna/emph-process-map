{
  "manifest_version": 3,
  "name": "EMPH Process Map Guide",
  "version": "1.0.0",
  "description": "Guided demos and training over live Dynamics 365 and Finance and Supply Chain, driven by the flows in the EMPH Process Map.",
  "background": {
    "service_worker": "bg.js"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.dynamics.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.dynamics.com/*"
      ],
      "js": [
        "main.js"
      ],
      "run_at": "document_idle",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.dynamics.com/*"
      ],
      "js": [
        "guide.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "minimum_chrome_version": "111"
}